{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.cypher-osiris/lumi-trades-mcp",
  "title": "Lumi Trades",
  "description": "Crypto signals, levels, market and institutional briefs for agents. Pay per call via x402: XRPL/Base",
  "repository": {
    "url": "https://github.com/cypher-osiris/lumi-api",
    "source": "github",
    "subfolder": "mcp"
  },
  "websiteUrl": "https://api.lumitrades.io/skill.md",
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "lumi-trades-mcp",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "XRPL_SEED",
          "description": "Seed of your XRPL wallet that pays for calls (signed locally)",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "LUMI_PAY_ASSET",
          "description": "XRP, RLUSD or USDC",
          "isRequired": false,
          "default": "XRP",
          "format": "string"
        },
        {
          "name": "LUMI_MAX_XRP_PER_CALL",
          "description": "Per-call cap in XRP",
          "isRequired": false,
          "default": "0.05",
          "format": "string"
        },
        {
          "name": "LUMI_SESSION_BUDGET",
          "description": "Max total spend per server process",
          "isRequired": false,
          "default": "1",
          "format": "string"
        },
        {
          "name": "XRPL_NETWORK",
          "description": "xrpl:0 mainnet or xrpl:1 testnet",
          "isRequired": false,
          "default": "xrpl:0",
          "format": "string"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.lumitrades.io/mcp"
    }
  ]
}
